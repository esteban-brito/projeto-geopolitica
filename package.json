{
  "name": "republica-simulator",
  "version": "0.1.0",
  "private": true,
  "description": "Simulador de presidente do Brasil — site estatico, sem build e sem dependencia de runtime.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "serve": "node tools/serve-static.mjs",
    "simulate": "node tools/simulate.mjs",
    "check": "node tests/run.mjs",
    "types": "tsc -p jsconfig.json",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "node --test \"tests/suites/*.mjs\"",
    "screen": "node tests/browser/screen-cost.mjs",
    "walk": "node tests/browser/walk.mjs",
    "validate": "npm run check && npm run types && npm run lint && npm run format && npm test && npm run walk"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "fast-check": "^4.9.0",
    "playwright": "^1.49.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  }
}
